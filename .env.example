# Local infrastructure. Copy this file to .env; never commit the copied file.
POSTGRES_USER=seedance
POSTGRES_PASSWORD=seedance-local-only
POSTGRES_DB=seedance_console
POSTGRES_PORT=45432
REDIS_PORT=46379
WEB_PORT=43170

DATABASE_URL=postgresql://seedance:seedance-local-only@127.0.0.1:45432/seedance_console?schema=public
REDIS_URL=redis://127.0.0.1:46379
STORAGE_ROOT=../../storage

API_HOST=127.0.0.1
API_PORT=43171
WEB_ORIGIN=http://localhost:43170
UPLOAD_MAX_BYTES=10485760
WORKER_HOST=127.0.0.1
WORKER_PORT=43172
WORKER_HEARTBEAT_KEY=seedance:worker:heartbeat
WORKER_HEARTBEAT_TTL_SECONDS=15
# Leave empty to use the Next.js same-origin API proxy.
NEXT_PUBLIC_API_URL=

# Mock remains the default. Real Provider values stay empty in source control.
SEEDANCE_PROVIDER=mock
SEEDANCE_BASE_URL=
SEEDANCE_API_KEY=
SEEDANCE_MODEL_ID=
SEEDANCE_REQUEST_TIMEOUT_MS=
SEEDANCE_POLL_INTERVAL_MS=
SEEDANCE_MAX_POLL_INTERVAL_MS=
SEEDANCE_MAX_POLL_DURATION_MS=
SEEDANCE_DOWNLOAD_TIMEOUT_MS=
SEEDANCE_DOWNLOAD_MAX_BYTES=536870912
SEEDANCE_DOWNLOAD_MAX_ATTEMPTS=5
SEEDANCE_DOWNLOAD_RETRY_INTERVAL_MS=2000
SEEDANCE_DOWNLOAD_MAX_RETRY_INTERVAL_MS=30000
SEEDANCE_MAX_DOWNLOAD_DURATION_MS=600000
SEEDANCE_POLL_JITTER_RATIO=0.1
WORKER_RECONCILE_INTERVAL_MS=10000
WORKER_RECONCILE_BATCH_SIZE=100
SEEDANCE_BRIDGE_URL=
SEEDANCE_BRIDGE_TOKEN=
REAL_API_TEST=false

# Server-only reference-image publishing. eos avoids any dependency on this
# server's public 80/443 ports; hmac remains available for rollback/fallback.
ASSET_PUBLISHER=hmac
SEEDANCE_ASSET_SIGNING_KEY=
SEEDANCE_ASSET_PUBLIC_BASE_URL=
SEEDANCE_ASSET_URL_TTL_MS=120000
SEEDANCE_ASSET_MAX_BYTES=10485760
# Console-local upload/publishing safety policy, not a Provider limit.
APP_VIDEO_MAX_BYTES=10485760
FFPROBE_PATH=ffprobe

# Private S3-compatible EOS settings. Required by the Worker only when the
# real Provider and ASSET_PUBLISHER=eos are enabled.
EOS_ENDPOINT=
EOS_REGION=
EOS_BUCKET=
EOS_ACCESS_KEY_ID=
EOS_SECRET_ACCESS_KEY=
EOS_OBJECT_PREFIX=seedance-inputs/
EOS_PRESIGN_TTL_SECONDS=3600
EOS_FORCE_PATH_STYLE=false
EOS_DELETE_ON_TERMINAL=true

# Private Python Bridge only. Put real values in an external mode-0600 env file.
BRIDGE_PROVIDER_MODE=disabled
AICC_BASE_URL=
AICC_API_KEY=
AICC_MODEL_ID=
AICC_PUBLIC_KEY_PATH=/var/lib/seedance-bridge/keys/seedance_pub.pem
AICC_PRIVATE_KEY_PATH=/var/lib/seedance-bridge/keys/seedance_priv.pem
AICC_OUTPUT_HOST_ALLOWLIST=
AICC_REQUEST_TIMEOUT_SECONDS=120
AICC_DOWNLOAD_TIMEOUT_SECONDS=180
AICC_MAX_DOWNLOAD_BYTES=536870912
