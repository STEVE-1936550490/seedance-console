{
  "name": "seedance-console",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "predev": "pnpm -r --filter './packages/**' build",
    "dev": "pnpm --parallel --filter './apps/**' dev",
    "build": "pnpm -r --filter './packages/**' build && pnpm -r --filter './apps/**' build && pnpm check:client-secrets",
    "lint": "eslint . && prettier --check .",
    "typecheck": "pnpm -r --filter './packages/**' build && pnpm -r --filter './apps/**' typecheck",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:client-secrets": "node scripts/check-client-secrets.mjs",
    "db:generate": "pnpm --filter @seedance/db db:generate",
    "db:migrate": "pnpm --filter @seedance/db db:migrate",
    "db:deploy": "pnpm --filter @seedance/db db:deploy",
    "eos:verify": "pnpm --filter @seedance/storage verify:eos",
    "eos:verify-reference-video": "pnpm --filter @seedance/worker verify:reference-video"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.15.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma"
    ]
  }
}
