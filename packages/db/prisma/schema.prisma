generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  DRAFT
  QUEUED
  SUBMITTING
  RECONCILIATION_REQUIRED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
}

enum AssetKind {
  INPUT_IMAGE
  INPUT_VIDEO
  OUTPUT_VIDEO
}

enum AssetRole {
  REFERENCE_IMAGE
  REFERENCE_VIDEO
  GENERATED_VIDEO
}

enum ProviderSubmissionStatus {
  ATTEMPTING
  ACCEPTED
  OUTCOME_UNKNOWN
  NOT_CREATED
}

model VideoTask {
  id                          String                   @id @default(cuid())
  clientRequestId             String                   @unique
  provider                    String                   @default("mock")
  providerTaskId              String?
  model                       String
  status                      TaskStatus               @default(QUEUED)
  prompt                      String
  parameters                  Json
  progress                    Int?
  errorCode                   String?
  errorMessage                String?
  createdAt                   DateTime                 @default(now())
  updatedAt                   DateTime                 @updatedAt
  submittedAt                 DateTime?
  completedAt                 DateTime?
  providerAssetCleanupReadyAt DateTime?                @db.Timestamptz(3)
  pollStartedAt               DateTime?
  nextPollAt                  DateTime?
  lastPolledAt                DateTime?
  pollDeadlineAt              DateTime?
  pollLeaseUntil              DateTime?
  pollVersion                 Int                      @default(0)
  pollAttempt                 Int                      @default(0)
  pollTransientErrors         Int                      @default(0)
  lastProviderStatus          String?
  lastPollError               String?
  downloadPending             Boolean                  @default(false)
  downloadStartedAt           DateTime?
  nextDownloadAt              DateTime?
  lastDownloadAt              DateTime?
  downloadDeadlineAt          DateTime?
  downloadLeaseUntil          DateTime?
  downloadVersion             Int                      @default(0)
  downloadAttempt             Int                      @default(0)
  downloadErrors              Int                      @default(0)
  lastDownloadError           String?
  events                      TaskEvent[]
  assets                      TaskAsset[]
  usageRecords                UsageRecord[]
  submission                  ProviderSubmission?
  videoOutput                 VideoOutput?
  publishedAssets             PublishedProviderAsset[]

  @@unique([provider, providerTaskId])
  @@index([status, createdAt])
  @@index([status, nextPollAt])
  @@index([status, downloadPending])
  @@index([status, nextDownloadAt])
}

model ProviderSubmission {
  id                   String                   @id @default(cuid())
  taskId               String                   @unique
  provider             String
  clientRequestId      String
  providerTaskId       String?
  status               ProviderSubmissionStatus @default(ATTEMPTING)
  errorCode            String?
  createAttemptId      String?                  @unique
  requestPayloadSha256 String?
  bridgeRequestId      String?
  requestStartedAt     DateTime?                @db.Timestamptz(3)
  requestEndedAt       DateTime?                @db.Timestamptz(3)
  failureStage         String?
  exceptionType        String?
  requestBodySent      Boolean?
  providerHttpStatus   Int?
  providerErrorCode    String?
  providerRequestId    String?
  providerTraceId      String?
  reconciliationNote   String?
  reconciledAt         DateTime?
  startedAt            DateTime                 @default(now())
  acceptedAt           DateTime?
  updatedAt            DateTime                 @updatedAt
  task                 VideoTask                @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([provider, clientRequestId])
  @@unique([provider, providerTaskId])
  @@index([status, updatedAt])
}

model Asset {
  id           String                   @id @default(cuid())
  kind         AssetKind
  storageKey   String                   @unique
  originalName String
  mimeType     String
  sizeBytes    BigInt
  checksum     String?
  durationMs   Int?
  width        Int?
  height       Int?
  codec        String?
  pixelFormat  String?
  frameRate    String?
  hasAudio     Boolean?
  createdAt    DateTime                 @default(now())
  tasks        TaskAsset[]
  videoOutput  VideoOutput?
  publications PublishedProviderAsset[]
}

model PublishedProviderAsset {
  id           String    @id @default(cuid())
  taskId       String
  assetId      String
  publisher    String
  bucket       String
  objectKey    String
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?
  cleanupError String?
  task         VideoTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  asset        Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([publisher, bucket, objectKey])
  @@index([taskId, deletedAt])
}

model VideoOutput {
  id             String    @id @default(cuid())
  taskId         String    @unique
  assetId        String    @unique
  providerTaskId String
  storageKey     String    @unique
  sha256         String
  fileSize       BigInt
  mimeType       String
  createdAt      DateTime  @default(now())
  task           VideoTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  asset          Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([providerTaskId])
}

model TaskAsset {
  taskId   String
  assetId  String
  role     AssetRole
  position Int       @default(0)
  task     VideoTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  asset    Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([taskId, assetId, role])
  @@index([taskId, role, position])
}

model TaskEvent {
  id         String      @id @default(cuid())
  taskId     String
  fromStatus TaskStatus?
  toStatus   TaskStatus
  reason     String?
  metadata   Json?
  createdAt  DateTime    @default(now())
  task       VideoTask   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model UsageRecord {
  id         String    @id @default(cuid())
  taskId     String
  provider   String
  metric     String
  quantity   Decimal   @db.Decimal(20, 6)
  unit       String
  raw        Json?
  recordedAt DateTime  @default(now())
  task       VideoTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, recordedAt])
}
